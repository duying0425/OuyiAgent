# Adapter listener. Keep 127.0.0.1 for local testing; use 0.0.0.0 inside Docker.
HOST=0.0.0.0
PORT=8081

# Secret used by New API or local clients to call this adapter.
ADAPTER_API_KEY=replace-with-a-long-random-internal-key

# Upstream Ouyi AI configuration. Never commit a real token.
OUYI_BASE_URL=https://api-8.rcouyi.com
OUYI_TOKEN=replace-with-a-dedicated-authorized-token

# Operational protection.
MAX_CONCURRENCY=3
MAX_REQUEST_BYTES=8388608
UPSTREAM_TIMEOUT_MS=300000
CATALOG_TTL_MS=600000
LOG_LEVEL=info

# Optional local test key for probe scripts
NEW_API_TEST_KEY=replace-with-a-test-key
